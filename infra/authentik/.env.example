# Copy to .env next to docker-compose.yml (on a plain Docker host), or enter
# these as the stack's environment variables in Portainer. .env is gitignored.
# The secrets are EMPTY on purpose: compose refuses to start until you fill
# them in, so nobody ever runs Authentik with a password from a repo.

# Authentik version. Pin it; upgrade one release at a time, after a backup.
AUTHENTIK_TAG=2026.8.5

# PostgreSQL. The names can stay as they are.
PG_DB=authentik
PG_USER=authentik
# Generated straight into .env without printing it: see README.md, "First run", step 3.
PG_PASS=

# Signs sessions and tokens. Set it once and never change it. Back it up
# together with the database. Generated the same way as PG_PASS (README.md).
AUTHENTIK_SECRET_KEY=

# Optional email (password recovery, admin alerts). If you use it, uncomment
# the AUTHENTIK_EMAIL__* lines in docker-compose.yml as well.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=auth@example.com
