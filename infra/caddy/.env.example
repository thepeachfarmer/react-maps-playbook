# Copy to .env next to docker-compose.yml (gitignored), or enter it as the
# stack's environment variable in Portainer. Only the Cloudflare DNS-01
# variant needs it; plain Caddy needs no .env at all.
#
# A scoped Cloudflare API token: Zone:Zone:Read and Zone:DNS:Edit for ONE zone
# (README.md, "The token"). Type it in an editor, never on a command line, and
# never paste it into a chat. Empty on purpose: with the token line in the
# compose file uncommented, compose refuses to start until it's set.
CLOUDFLARE_API_TOKEN=
