# Copy to secrets/portainer.env (gitignored), then: chmod 600 secrets/portainer.env
# Placeholders only. Never commit the real file.

# Your Portainer's address. HTTPS, please: the key below travels in every request.
PORTAINER_URL=https://portainer.example.com

# A Portainer access token (My account > Access tokens). Make it for a Portainer
# user that can only see the environment it deploys to, and delete it when it's
# no longer needed. Or keep it in the macOS Keychain instead:
#   security add-generic-password -U -s react-maps -a PORTAINER_API_KEY -w
# and pass --keychain-service react-maps.
PORTAINER_API_KEY=YOUR_TOKEN
