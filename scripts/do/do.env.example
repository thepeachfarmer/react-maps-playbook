# Copy to secrets/do.env (gitignored), then: chmod 600 secrets/do.env
# Every value below is a placeholder. Never commit the real file.

# --- the only secret ---------------------------------------------------------
# A scoped DigitalOcean API token with an expiry (docs/12). Scripts read it at
# run time; it is never printed. Or keep it in the macOS Keychain instead:
#   security add-generic-password -U -s react-maps -a DIGITALOCEAN_ACCESS_TOKEN -w
# and set KEYCHAIN_SERVICE=react-maps (or pass --keychain-service react-maps)
# when you run the scripts.
DIGITALOCEAN_ACCESS_TOKEN=YOUR_TOKEN

# --- settings (not secret; flags on the command line override these) ----------
DROPLET_NAME=maps-demo
REGION=nyc3
SIZE=s-1vcpu-1gb
IMAGE=ubuntu-24-04-x64

# The NAME of an SSH key already on your DigitalOcean account whose PRIVATE
# half is on this machine (provision-droplet.sh checks).
SSH_KEY_NAME=my-laptop

# What the droplet runs, and the hostname Caddy gets a certificate for.
# cloud-init's Caddyfile proxies to web:80 (the example's nginx image). An image
# that listens on another port needs that line changed (docs/11).
APP_IMAGE=ghcr.io/your-org/react-maps-example:latest
DOMAIN=example.com
RECORD=maps

# yes = create/update the A record in DigitalOcean DNS (the domain's nameservers
# must be ns1/ns2/ns3.digitalocean.com). no = you add the A record yourself, and
# you DELETE it yourself when you destroy the droplet (destroy-droplet.sh warns
# you): a record left pointing at a released IP can be taken over.
MANAGE_DNS=no

# Keep a reserved (static) IP so a re-created droplet keeps its address.
RESERVED_IP=yes

# Who may SSH in. Default is anywhere (keys only, no passwords). Tighter:
# SSH_FROM=203.0.113.10/32
SSH_FROM=0.0.0.0/0,::/0

BACKUPS=yes
