{
  "name": "react-maps-example",
  "private": true,
  "version": "1.0.0",
  "description": "A small, runnable React + Leaflet farm map that demonstrates the patterns in this playbook. All data is invented.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server && vite build",
    "preview": "vite preview --port 4173",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit && tsc -p server",
    "make-share": "node scripts/make-demo-share.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "leaflet": "1.9.4",
    "openid-client": "6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
