# Copy to .env for local use. .env is gitignored and dockerignored.
# Every value here is a harmless placeholder.

# --- docker compose ---
HOST_PORT=8080
IMAGE=ghcr.io/your-org/react-maps-example
IMAGE_TAG=latest

# --- build-time (Vite inlines VITE_* when it builds; changing them later does nothing) ---
VITE_APP_VERSION=1.0.dev
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- optional Node server: example/server (npm start, or docker build --target server) ---
# Sign-in is OFF by default and everyone is the made-up "Demo User".
# The server image sets NODE_ENV=production, and in production the server REFUSES
# to start with sign-in off unless you say so on purpose:
# ALLOW_NO_AUTH=true
# PORT=3000
#
# Sign-in with your identity provider (docs/14-login-with-authentik.md).
# Real values go in a gitignored .env or the Portainer stack env, never here.
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://auth.example.com/application/o/demo-map/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://maps.example.com/api/auth/callback
# Generate it straight into .env, so it's never printed (production refuses short or default values):
#   printf 'SESSION_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# SESSION_SECRET=
# IdP group -> role. DEFAULT_ROLE=none (also what you get when it's unset)
# refuses people in no listed group; DEFAULT_ROLE=viewer lets anyone who can
# sign in look, so set that only on purpose.
# ROLE_MAP={"demo-map-admins":"admin","demo-map-operators":"operator","demo-map-viewers":"viewer"}
# DEFAULT_ROLE=none
# Where "Sign out" sends the browser so the IdP session ends too:
# OIDC_LOGOUT_URL=https://auth.example.com/if/flow/default-invalidation-flow/
# Without OIDC_LOGOUT_URL the server uses the IdP's end-session endpoint and comes back here:
# OIDC_POST_LOGOUT_REDIRECT_URI=https://maps.example.com/
# Shows "Add a passkey" in the user menu:
# OIDC_PASSKEY_URL=https://auth.example.com/if/flow/default-authenticator-webauthn-setup/
# OIDC_SCOPES=openid profile email
